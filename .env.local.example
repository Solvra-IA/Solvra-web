# Resend — https://resend.com/api-keys (nunca commitear claves reales)
RESEND_API_KEY=

# URL pública del sitio (usada en metadata, sitemap, OG)
# Producción: https://nexus-ia.es
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email de destino para el formulario de contacto
# CONTACT_FROM_EMAIL debe ser de un dominio verificado en Resend (p. ej. hola@nexus-ia.es)
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# URL directa para fallback comercial (opcional), ej:
# https://wa.me/34123456789?text=Hola%20equipo%20Nexus%2C%20quiero%20informaci%C3%B3n
NEXT_PUBLIC_WHATSAPP_URL=
